NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://miniapp:miniapp@localhost:5432/miniapp?schema=public

# URL công khai của mini-app (dùng để dựng link thanh toán / redirect)
WEB_URL=http://localhost:3000

# Đổi toàn bộ secret khi lên môi trường thật
SESSION_JWT_SECRET=change-me-session
ADMIN_JWT_SECRET=change-me-admin
MOCK_PAY_SECRET=change-me-mock-pay

# Thời gian giữ đơn chờ thanh toán (phút)
ORDER_PAYMENT_TTL_MINUTES=15

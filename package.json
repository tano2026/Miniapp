{
  "name": "travel-services-miniapp",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:seed": "pnpm --filter api seed"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "@prisma/client", "@prisma/engines", "prisma", "esbuild", "sharp", "unrs-resolver"]
  }
}
